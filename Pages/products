# Welcome message
st.title("Welcome to our makeup store! 💄", text_alignment="center")
# Display the products and their prices
Lips_tab, Face_tab, Eyes_tab = st.tabs(['Lips💋' , 'Face👩‍🦰', 'Eyes 👁️'])
with Lips_tab:
    st.subheader("Lips Products")
    col1, col2, col3 = st.columns(3)
    stick_shades = list(Lips["Lip stick"].keys())
    lippalm_shades = list(Lips["Lip palm"].keys())
    lipgloss_shades = list(Lips["Lip gloss"].keys())
    with col1:
       st.image("Images/Redlipstick.png",width=190)
       st.subheader("Lip stick", 
                    text_alignment="center")
       lipstick_shade = st.segmented_control('stickShades:',default='Red', options=stick_shades,)
    with col2:
       st.image("Images/palm.png",width=190)
       st.subheader("Lip palm", 
                    text_alignment="center")
       lippalm_shades = st.segmented_control('palmShades:',default='Red', options=lippalm_shades,)
    with col3:
       st.image("Images/gloss.png",width=190)
       st.subheader("Lip gloss", 
                    text_alignment="center")
       lipgloss_shades = st.segmented_control('glossShades:',default='Clear', options=lipgloss_shades,)
